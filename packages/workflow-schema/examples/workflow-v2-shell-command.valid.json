{
  "schemaVersion": "2",
  "name": "Pilot shell command dry-run safe workflow",
  "description": "Shared valid v2 shell_command fixture for Pilot Phase B tests.",
  "catalogVersion": "pilot.v1",
  "secrets": [],
  "steps": [
    {
      "id": "run-echo",
      "name": "Run echo command",
      "type": "shell_command",
      "risk": "low",
      "action": {
        "type": "shell_command",
        "version": "pilot.v1",
        "params": {
          "command": "printf 'pilot-b\\n'",
          "timeout_seconds": 30,
          "working_directory": ".",
          "environment": {
            "PILOT_PHASE": "B"
          }
        }
      },
      "timeoutSeconds": 30,
      "retry": {
        "maxAttempts": 1
      },
      "idempotency": {
        "mode": "none"
      },
      "dryRun": {
        "supported": true,
        "strategy": "validate_only"
      },
      "artifacts": [
        {
          "key": "stdout",
          "name": "stdout.txt",
          "kind": "stdout",
          "required": false
        }
      ]
    }
  ]
}
