{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinitionV2",
  "description": "Workflow definition schema v2. Introduces schemaVersion, structured action objects per step, and an expanded action type catalog.",
  "type": "object",
  "required": ["schemaVersion", "name", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2",
      "description": "Must be '2' for v2 workflows."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string"
    },
    "catalogVersion": {
      "type": "string",
      "description": "Action catalog version. Supported values are validated semantically. Defaults to 'pilot.v1' when absent."
    },
    "defaults": {
      "$ref": "#/definitions/WorkflowDefaults"
    },
    "secrets": {
      "type": "array",
      "items": { "$ref": "#/definitions/SecretDeclaration" },
      "default": []
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Step" }
    }
  },
  "definitions": {
    "RiskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "WorkflowDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "retry": { "$ref": "#/definitions/RetrySpec" }
      }
    },
    "SecretDeclaration": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "provider": { "type": "string" },
        "ref": { "type": "string" },
        "scope": { "type": "object" },
        "requiredBy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "injectAs": { "type": "object" },
        "redactionHints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ArtifactDeclaration": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["file", "report", "stdout", "stderr", "log"]
        },
        "mimeType": { "type": "string" },
        "required": { "type": "boolean", "default": false },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "contentDisposition": { "type": "string" },
        "evidenceRole": { "type": "string" }
      }
    },
    "RetrySpec": {
      "type": "object",
      "required": ["maxAttempts"],
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoffSeconds": { "type": "integer", "minimum": 0 },
        "retryOn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["runner_transient", "network_transient", "timeout", "rate_limited"]
          }
        }
      }
    },
    "IdempotencySpec": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "natural", "keyed", "external"]
        },
        "key": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "DryRunSpec": {
      "type": "object",
      "required": ["supported", "strategy"],
      "additionalProperties": false,
      "properties": {
        "supported": { "type": "boolean" },
        "strategy": {
          "type": "string",
          "description": "Supported strategies validated semantically: native, validate_only, mock, unsupported."
        },
        "requiresSecrets": { "type": "boolean", "default": false }
      }
    },
    "ManualTaskAction": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "manual_task" },
        "version": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructions": { "type": "string", "minLength": 1 },
            "expected_outcome": { "type": "string" }
          }
        },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" }
      }
    },
    "ApprovalGateAction": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "approval_gate" },
        "version": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" }
      }
    },
    "ShellCommandAction": {
      "type": "object",
      "required": ["type", "params"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "shell_command" },
        "version": { "type": "string" },
        "params": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "working_directory": { "type": "string" },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" }
      }
    },
    "HttpRequestAction": {
      "type": "object",
      "required": ["type", "params"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "http_request" },
        "version": { "type": "string" },
        "params": {
          "type": "object",
          "required": ["method", "url"],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
            },
            "url": { "type": "string", "minLength": 1 },
            "headers": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "body": {},
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "expected_status_codes": {
              "type": "array",
              "items": { "type": "integer", "minimum": 100, "maximum": 599 },
              "minItems": 1
            }
          }
        },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" }
      }
    },
    "ArtifactAssertionAction": {
      "type": "object",
      "required": ["type", "params"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "artifact_assertion" },
        "version": { "type": "string" },
        "params": {
          "type": "object",
          "required": ["artifact_key", "assertion"],
          "additionalProperties": false,
          "properties": {
            "artifact_key": { "type": "string", "minLength": 1 },
            "assertion": {
              "type": "string",
              "enum": ["exists", "not_exists", "content_matches"]
            },
            "pattern": { "type": "string" }
          },
          "if": {
            "properties": { "assertion": { "const": "content_matches" } },
            "required": ["assertion"]
          },
          "then": { "required": ["pattern"] }
        },
        "inputs": { "type": "object" },
        "outputs": { "type": "object" }
      }
    },
    "Action": {
      "oneOf": [
        { "$ref": "#/definitions/ManualTaskAction" },
        { "$ref": "#/definitions/ApprovalGateAction" },
        { "$ref": "#/definitions/ShellCommandAction" },
        { "$ref": "#/definitions/HttpRequestAction" },
        { "$ref": "#/definitions/ArtifactAssertionAction" }
      ]
    },
    "Step": {
      "type": "object",
      "required": ["id", "name", "type", "risk", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["manual_task", "approval_gate", "shell_command", "http_request", "artifact_assertion"]
        },
        "risk": { "$ref": "#/definitions/RiskLevel" },
        "requiresApproval": { "type": "boolean" },
        "approvalTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "action": { "$ref": "#/definitions/Action" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "retry": { "$ref": "#/definitions/RetrySpec" },
        "idempotency": { "$ref": "#/definitions/IdempotencySpec" },
        "dryRun": { "$ref": "#/definitions/DryRunSpec" },
        "secrets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "References to top-level secret declaration keys."
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/ArtifactDeclaration" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "manual_task" } }, "required": ["type"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "manual_task" } }, "required": ["type"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "approval_gate" } }, "required": ["type"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "approval_gate" } }, "required": ["type"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "shell_command" } }, "required": ["type"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "shell_command" } }, "required": ["type"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "http_request" } }, "required": ["type"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "http_request" } }, "required": ["type"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "artifact_assertion" } }, "required": ["type"] },
          "then": { "properties": { "action": { "properties": { "type": { "const": "artifact_assertion" } }, "required": ["type"] } } }
        }
      ]
    }
  }
}
