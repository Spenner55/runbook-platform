{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtifactAssertionAction",
  "description": "Asserts a condition about a named artifact produced during execution.",
  "type": "object",
  "required": ["type", "params"],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "const": "artifact_assertion" },
    "params": {
      "type": "object",
      "required": ["artifact_key", "assertion"],
      "additionalProperties": false,
      "properties": {
        "artifact_key": { "type": "string", "minLength": 1 },
        "assertion": {
          "type": "string",
          "enum": ["exists", "not_exists", "content_matches"]
        },
        "pattern": { "type": "string" }
      },
      "if": {
        "properties": { "assertion": { "const": "content_matches" } },
        "required": ["assertion"]
      },
      "then": { "required": ["pattern"] }
    }
  }
}
