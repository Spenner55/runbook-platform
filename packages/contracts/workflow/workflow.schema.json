{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowDefinition",
  "type": "object",
  "required": ["name", "steps"],
  "properties": {
    "name": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "risk"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "risk": { "type": "string" },
          "command": { "type": "string" },
          "requiresApproval": { "type": "boolean" }
        }
      }
    }
  }
}
