# Postgres
POSTGRES_DB=runbook_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/runbook_platform

# FastAPI AI
OPENAI_API_KEY=
AI_SERVICE_PORT=8001

# Internal service URLs
API_BASE_URL=http://api:8000
AI_BASE_URL=http://ai:8001

# AI service timeout settings (seconds; defaults shown)
AI_CONNECT_TIMEOUT_SECONDS=1.0
AI_READ_TIMEOUT_SECONDS=20.0
AI_WRITE_TIMEOUT_SECONDS=5.0
AI_POOL_TIMEOUT_SECONDS=1.0

# Integrations
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_FERNET_KEY=
INTEGRATION_DISPATCH_TIMEOUT_SECONDS=3.0

# Artifact storage
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_MEDIA_ROOT=/app/media/artifacts
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_PREFIX=artifacts/
ARTIFACT_ALLOWED_MIME_TYPES=
ARTIFACT_REQUIRE_CHECKSUM=1
ARTIFACT_MAX_UPLOAD_BYTES=52428800
ARTIFACT_MAX_ARTIFACTS_PER_STEP=10
ARTIFACT_MAX_TOTAL_BYTES_PER_EXECUTION=262144000
ARTIFACT_DAILY_BYTES_PER_RUNNER=1073741824
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300
ARTIFACT_MAX_METADATA_BYTES=8192
ARTIFACT_STDOUT_STDERR_MAX_BYTES=5242880

# Runner
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_REGISTRATION_TOKEN=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8000
