# Postgres
POSTGRES_DB=runbook_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PGBOUNCER_POOL_SIZE=20
PGBOUNCER_MAX_CLIENT_CONN=100

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_LOG_LEVEL=INFO
# JWT
# Access tokens live 15 minutes; refresh tokens live 7 days (httpOnly cookie).
# No additional env var required — lifetimes are set in settings.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
# Compose routes Django through PgBouncer by default. For direct Postgres
# troubleshooting, temporarily point this at postgres:5432 instead.
DATABASE_URL=postgresql://postgres:postgres@pgbouncer:5432/runbook_platform

# FastAPI AI
#
# COST WARNING: enabling LLM parsing sends runbook text to OpenAI.
# Each call costs real money. Do not enable in CI without explicit budget approval.
#
# Step 1: Set your key manually. Never commit a real key.
# Required only for real LLM parsing. Normal local/test/lint/build commands do not need it.
# docker-compose passes this only to the ai service.
OPENAI_API_KEY=
#
# Step 2: Choose a model explicitly. No default is intentional.
#   Example: AI_PARSE_MODEL=gpt-4o
AI_PARSE_MODEL=
#
# Step 3: Safe local/default mode is false. Flip to true only after the above two are set.
AI_USE_LLM_PARSER=false
#
# Step 4: Opt in to LLM integration tests (costs money; never enable in CI by default).
# Must be true, with OPENAI_API_KEY present, before tests marked "llm" will run.
AI_ENABLE_LLM_TESTS=false
#
AI_SERVICE_PORT=8001
AI_MAX_INPUT_CHARS=100000

# Internal service URLs
API_BASE_URL=http://api:8000
AI_BASE_URL=http://ai:8001

# AI service timeout settings (seconds; defaults shown)
AI_CONNECT_TIMEOUT_SECONDS=1.0
AI_READ_TIMEOUT_SECONDS=60.0
AI_WRITE_TIMEOUT_SECONDS=5.0
AI_POOL_TIMEOUT_SECONDS=1.0

# Integrations
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_FERNET_KEY=
INTEGRATION_DISPATCH_TIMEOUT_SECONDS=3.0
INTEGRATION_DISPATCH_BUDGET_SECONDS=10.0
INTEGRATION_MAX_PER_TRIGGER=25

# Artifact storage
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_MEDIA_ROOT=/app/media/artifacts
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_PREFIX=artifacts/
ARTIFACT_ALLOWED_MIME_TYPES=
ARTIFACT_REQUIRE_CHECKSUM=1
ARTIFACT_MAX_UPLOAD_BYTES=52428800
ARTIFACT_MAX_ARTIFACTS_PER_STEP=10
ARTIFACT_MAX_TOTAL_BYTES_PER_EXECUTION=262144000
ARTIFACT_DAILY_BYTES_PER_RUNNER=1073741824
ARTIFACT_DOWNLOAD_URL_TTL_SECONDS=300
ARTIFACT_MAX_METADATA_BYTES=8192
ARTIFACT_STDOUT_STDERR_MAX_BYTES=5242880

# Runner
# Required shared secret for runner-only internal API calls.
# Generate a high-entropy value for each environment. Never use "change-me".
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_REGISTRATION_TOKEN=
WATCHDOG_STUCK_THRESHOLD_SECONDS=300
EXECUTION_LIST_CACHE_SECONDS=5
EXECUTION_LIST_CACHE_STALE_SECONDS=60
JWT_USER_CACHE_SECONDS=60

# Runner sandbox execution
# RUNNER_EXECUTION_MODE controls whether steps run in simulation (no subprocess) or a real sandbox.
# Default is "simulated" for compatibility. Set to "sandboxed" to enable real command execution.
RUNNER_EXECUTION_MODE=simulated
RUNNER_SANDBOX_PROVIDER=local_process
RUNNER_SANDBOX_WORKSPACE_ROOT=/tmp/runner-workspaces
# Cleanup policy after each step: always | on_success | never
RUNNER_SANDBOX_CLEANUP_POLICY=always
RUNNER_SANDBOX_DEFAULT_TIMEOUT_SECONDS=300
RUNNER_SANDBOX_STDOUT_MAX_BYTES=5242880
RUNNER_SANDBOX_STDERR_MAX_BYTES=5242880
RUNNER_SANDBOX_ARTIFACT_MAX_BYTES=52428800
RUNNER_SANDBOX_MAX_ARTIFACTS_PER_STEP=10
# Comma-separated env var prefixes/names forwarded into the sandbox (e.g. MY_APP_,CI_)
RUNNER_SANDBOX_ALLOWED_ENV_PREFIXES=
RUNNER_SANDBOX_ALLOWED_ENV_NAMES=
# Shell execution: disabled by default. Set path and flip allow to true together.
RUNNER_SANDBOX_SHELL_PATH=/bin/sh
RUNNER_SANDBOX_ALLOW_SHELL=false

# Production security
# CORS: space- or comma-separated list of allowed origins (prod only).
CORS_ALLOWED_ORIGINS=https://app.example.com

# Rate limiting (django-ratelimit). Only active when RATELIMIT_ENABLE=True (prod settings).
DJANGO_RATE_LIMIT_ANON=100/m
DJANGO_RATE_LIMIT_USER=1000/m

# Prometheus metrics scraping. Disabled by default.
# If true, PROMETHEUS_METRICS_TOKEN must also be set or startup will fail.
PROMETHEUS_METRICS_ENABLED=false
PROMETHEUS_METRICS_TOKEN=

# Django admin endpoint. Disabled by default in production.
DJANGO_ADMIN_ENABLED=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000
