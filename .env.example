# Postgres
POSTGRES_DB=runbook_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/runbook_platform

# FastAPI AI
OPENAI_API_KEY=
AI_SERVICE_PORT=8001

# Internal service URLs
API_BASE_URL=http://api:8000
AI_BASE_URL=http://ai:8001

# Runner
RUNNER_POLL_INTERVAL_SECONDS=5
RUNNER_REGISTRATION_TOKEN=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8000
